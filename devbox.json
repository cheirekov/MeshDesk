{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "python312@latest",
    "uv@latest"
  ],
  "shell": {
    "scripts": {
      "setup": [
        "uv sync --frozen"
      ],
      "start": [
        "uv run meshdesk"
      ],
      "test": [
        "uv run pytest"
      ],
      "check": [
        "uv run ruff check .",
        "uv run pytest"
      ]
    }
  }
}
